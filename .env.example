# =============================================================================
# Jxf-AI · 环境变量模板（Phase 0）
#
# 使用：
#   cp .env.example .env
#   替换所有 CHANGE_ME 值后执行：
#   docker compose -f docker/docker-compose.yml --env-file .env up -d --build
#
# 注意：
#   1. .env 禁止提交到仓库（已在 .gitignore 中忽略）
#   2. JXF_AUTH_SECRET 缺失 / 少于 32 字符 / 命中弱值黑名单 → web 拒绝启动
#   3. PostgreSQL / MinIO 口令会拼进连接串，请只使用 [A-Za-z0-9] 字符
#   4. 生成随机值：openssl rand -hex 32
# =============================================================================

# -----------------------------------------------------------------------------
# 通用
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=jxf-ai
# production | staging | development
JXF_ENV=production
# debug | info | warn | error
JXF_LOG_LEVEL=info
JXF_VERSION=0.1.0-p0
# 构建期 npm registry（内网 / 国内镜像可改为 https://registry.npmmirror.com）
NPM_REGISTRY=https://registry.npmjs.org

# Caddy 站点地址：默认 :80（HTTP）。生产填域名并在 docker/Caddyfile 中启用 TLS
JXF_SITE_ADDRESS=:80
JXF_HTTP_PORT=80
JXF_HTTPS_PORT=443

# -----------------------------------------------------------------------------
# 安全（必改）
# -----------------------------------------------------------------------------
# 会话签名密钥，>= 32 字符；禁止使用 change-me / placeholder 等弱值
JXF_AUTH_SECRET=CHANGE_ME_USE_openssl_rand_hex_32

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_DB=jxf
# 超级用户：仅用于 initdb 与运维排障，禁止给应用使用
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_postgres_superuser_password
# 宿主机回环地址映射端口（运维排障用，业务走容器网络）
POSTGRES_PORT=5432

# 迁移角色：拥有库与表结构，供 migrate 容器使用
JXF_OWNER_USER=jxf_owner
JXF_OWNER_PASSWORD=CHANGE_ME_owner_password

# 运行时业务角色：NOSUPERUSER / NOBYPASSRLS，web 只能用它连接
JXF_APP_USER=jxf_app
JXF_APP_PASSWORD=CHANGE_ME_app_password

# -----------------------------------------------------------------------------
# MinIO（对象存储）
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=jxf_minio_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_root_password
MINIO_BUCKET=jxf-assets
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_REGION=us-east-1
