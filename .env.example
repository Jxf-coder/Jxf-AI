# =============================================================================
# Jxf-AI · 环境变量模板（Phase 0）
#
# 使用：
#   cp .env.example .env
#   替换所有 CHANGE_ME 值后执行：
#   docker compose -f docker/docker-compose.yml --env-file .env up -d --build
#
# 注意：
#   1. .env 禁止提交到仓库（已在 .gitignore 中忽略）
#   2. JXF_AUTH_SECRET 缺失 / 少于 32 字符 / 命中弱值黑名单 → web 拒绝启动
#   3. PostgreSQL / MinIO 口令会拼进连接串，请只使用 [A-Za-z0-9] 字符
#   4. 生成随机值：openssl rand -hex 32
# =============================================================================

# -----------------------------------------------------------------------------
# 通用
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=jxf-ai
# production | staging | development
JXF_ENV=production
# debug | info | warn | error
JXF_LOG_LEVEL=info
JXF_VERSION=0.1.0-p0
# 构建期 npm registry（内网 / 国内镜像可改为 https://registry.npmmirror.com）
NPM_REGISTRY=https://registry.npmjs.org

# 单租户标识：私有化交付下恒为单值，仅作未来 SaaS 预留
JXF_TENANT_ID=00000000-0000-4000-8000-000000000001

# 仅开发种子使用：npm run seed 会创建演示账号（生产禁止设置）
SEED_PASSWORD=CHANGE_ME_dev_seed_password

# Caddy 站点地址：默认 :80（HTTP）。生产填域名并在 docker/Caddyfile 中启用 TLS
JXF_SITE_ADDRESS=:80
JXF_HTTP_PORT=80
JXF_HTTPS_PORT=443

# 侧边栏文字 Logo（可留空，默认 Jxf-AI）。后续由企业设置覆盖
JXF_SITE_NAME=Jxf-AI

# -----------------------------------------------------------------------------
# 安全（必改）
# -----------------------------------------------------------------------------
# 会话签名密钥，>= 32 字符；禁止使用 change-me / placeholder 等弱值
JXF_AUTH_SECRET=CHANGE_ME_USE_openssl_rand_hex_32

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_DB=jxf
# 超级用户：仅用于 initdb 与运维排障，禁止给应用使用
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_postgres_superuser_password
# 宿主机回环地址映射端口（运维排障用，业务走容器网络）
POSTGRES_PORT=5432

# 迁移角色：拥有库与表结构，供 migrate 容器使用
JXF_OWNER_USER=jxf_owner
JXF_OWNER_PASSWORD=CHANGE_ME_owner_password

# 运行时业务角色：NOSUPERUSER / NOBYPASSRLS，web 只能用它连接
JXF_APP_USER=jxf_app
JXF_APP_PASSWORD=CHANGE_ME_app_password

# M3 worker 角色：只拿运行时队列表的 DML，不持有业务表权限
JXF_WORKER_USER=app_worker
JXF_WORKER_PASSWORD=CHANGE_ME_worker_password

# -----------------------------------------------------------------------------
# MinIO（对象存储）
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=jxf_minio_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_root_password
MINIO_BUCKET=jxf-assets
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_REGION=us-east-1

# -----------------------------------------------------------------------------
# AI（OpenAI 标准兼容格式，知识库问答与 M3 工具调用共用）
# -----------------------------------------------------------------------------
# false 或缺少 Key 时不报错：检索自动降级为 pg_bigm 纯关键词通道，问答直接拒绝生成
JXF_AI_ENABLED=false
# 官方：https://api.openai.com/v1
# 硅基流动：https://api.siliconflow.cn/v1
# DeepSeek：https://api.deepseek.com/v1
JXF_AI_BASE_URL=https://api.openai.com/v1
JXF_AI_API_KEY=
# 双模型分工：
#   PRO   → 深度推理：顾问问答、复杂检索生成
#   FLASH → 高频轻量：文档巡读、抽取、蒸馏建卡、摘要
# DeepSeek 服务端实际模型名：deepseek-v4-pro / deepseek-flash
JXF_AI_MODEL_PRO=deepseek-v4-pro
JXF_AI_MODEL_FLASH=deepseek-flash
# 超时按推理型模型放宽：pro 单轮含思考通常 5-10s
JXF_AI_TIMEOUT_MS=60000
# 容灾：503 / 429 / 5xx / 超时 / 连接重置按指数避让重试（0 = 关闭重试）
JXF_AI_RETRY_ATTEMPTS=2
JXF_AI_RETRY_BASE_MS=500
# 备用 LLM 节点（OpenAI 兼容）：主节点重试耗尽后自动接续，避免前端直接报错；
# 留空即不启用。未单独指定模型名时沿用主节点模型名。
JXF_AI_FALLBACK_BASE_URL=
JXF_AI_FALLBACK_API_KEY=
JXF_AI_FALLBACK_MODEL_PRO=
JXF_AI_FALLBACK_MODEL_FLASH=
# 单轮问答召回条数与最大输出 token
# 推理型模型的思考 token 也计入 max_tokens，建议 >= 2048
JXF_AI_TOP_K=6
JXF_AI_MAX_TOKENS=2048

# Embedding（可与管理模型分开配置；维度必须与 doc_chunks.embedding 的 vector(1024) 一致）
# 注意：DeepSeek 等对话服务不提供 embedding，必须单独配置；
#       留空则向量通道关闭，检索自动降级为 pg_bigm 关键词（页面会如实显示）
# 中文推荐 bge-m3（硅基流动提供），维度 1024
# Gemini（OpenAI 兼容端点）：https://generativelanguage.googleapis.com/v1beta/openai
#   → JXF_EMBEDDING_MODEL=gemini-embedding-001（支持 1024 维输出）
JXF_EMBEDDING_BASE_URL=https://api.openai.com/v1
JXF_EMBEDDING_API_KEY=
JXF_EMBEDDING_MODEL=text-embedding-3-small
JXF_EMBEDDING_DIM=1024

# 扫描件 OCR（Gemini 视觉，原生 generateContent + inline_data）
# 默认关闭：开启后扫描件与图片会发送给外部模型；失败自动回落「待 OCR」人工补录
JXF_OCR_ENABLED=false
JXF_OCR_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# 留空则复用 JXF_EMBEDDING_API_KEY（同一个 AI Studio 项目）
JXF_OCR_API_KEY=
JXF_OCR_MODEL=gemini-3.1-flash-lite
JXF_OCR_TIMEOUT_MS=90000
JXF_OCR_MAX_BYTES=15000000
