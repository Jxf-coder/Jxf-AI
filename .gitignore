# 依赖与构建产物
node_modules/
.next/
# 知识库本地分级存储：用户上传的原始文件，不入仓库
public/uploads/
out/
*.tsbuildinfo

# 环境变量：仅保留模板（含任意子目录）
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# 私钥与证书
*.pem
*.key
*.p12
*.pfx

# 运行时数据与日志
data/
logs/
*.log
npm-debug.log*

# 本地数据库与转储（数据库跑在 Docker 卷里，不进入版本库）
*.db
*.sqlite
*.sqlite3
*.dump
pgdata/
backup/
backups/

# 系统文件
.DS_Store
Thumbs.db

# 项目文档：只保留在工作区，不进入版本库与远程仓库
docs/
doc/

# AOCI 项目级 MCP 配置：含本机绝对路径与数据库连接串，只保留在本地
.trae/mcp.json
