{
  "name": "jxf-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Jxf-AI 工作台：私有化交付的 AI 员工平台",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "seed": "node --env-file=.env --import tsx db/seed/dev.ts",
    "test:rls": "node --env-file=.env scripts/test-rls.mjs",
    "test:permissions": "node --import tsx scripts/test-permissions.mjs",
    "test:permission-core": "node --import tsx scripts/test-permission-core.mjs",
    "test:snapshot": "node --import tsx scripts/test-permission-snapshot.mjs",
    "test:context": "node --env-file=.env scripts/test-active-context.mjs",
    "test:permission-admin-db": "node --env-file=.env scripts/test-permission-admin.mjs",
    "test:handover": "node --env-file=.env scripts/test-pending-handover.mjs",
    "test:knowledge": "node --env-file=.env --import tsx scripts/test-knowledge.mjs",
    "test:ai-employees": "node --env-file=.env --import tsx scripts/test-ai-employees.mjs",
    "test:runtime": "node --env-file=.env --import tsx scripts/test-runtime.mjs",
    "test:settings": "node --env-file=.env --import tsx scripts/test-app-settings.mjs",
    "test:mcp-health": "node --env-file=.env --import tsx scripts/test-mcp-health.mjs",
    "test:pipelines": "node --env-file=.env --import tsx scripts/test-pipelines.mjs",
    "test:notifications": "node --env-file=.env --import tsx scripts/test-notifications.mjs",
    "backup": "node --env-file=.env scripts/backup.mjs",
    "restore": "node --env-file=.env scripts/restore.mjs",
    "upgrade": "node --env-file=.env scripts/upgrade.mjs",
    "rollback": "node --env-file=.env scripts/rollback.mjs",
    "smoke": "node --env-file=.env scripts/smoke.mjs",
    "audit:prune": "node --env-file=.env scripts/prune-audit.mjs",
    "audit:grants": "node --env-file=.env --import tsx scripts/audit-grants.mjs",
    "ops:runner": "node --env-file=.env --import tsx scripts/ops-runner.mjs",
    "verify:delivery": "node --env-file=.env scripts/verify-delivery.mjs",
    "worker": "node --env-file=.env --import tsx src/worker/main.ts",
    "probe:embedding": "node --env-file=.env scripts/probe-embedding.mjs",
    "backfill:embeddings": "node --env-file=.env scripts/backfill-embeddings.mjs",
    "verify:guards": "node scripts/verify-permission-guards.mjs"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@aws-sdk/client-s3": "^3.1162.0",
    "@aws-sdk/s3-request-presigner": "^3.1162.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.68.0",
    "mammoth": "^1.13.0",
    "next": "^15.5.29",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^10.3.1",
    "pg": "^8.16.3",
    "pinyin-pro": "^3.29.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "unpdf": "^1.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.6.2",
    "drizzle-kit": "^0.31.4",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3"
  }
}
